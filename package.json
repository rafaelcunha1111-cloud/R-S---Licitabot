{
  "name": "r-s---licitabot",
  "version": "1.0.0",
  "description": "Central de monitoramento de licitações R&S LicitaBot",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "check": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts",
    "build": "vite build",
    "start": "tsx server/index.ts"
  },
