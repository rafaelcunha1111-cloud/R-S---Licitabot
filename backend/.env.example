# Copie para backend/.env; carregue com node --env-file=.env ou pelo provedor.
# NUNCA coloque valores reais neste exemplo. Campos opcionais vazios devem ser omitidos.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/licitabot?sslmode=verify-full
# auto: TLS validado em produção, exceto URL interna curta na plataforma Render.
# Render interno: URL interna original, sem sslmode=require, e RENDER=true injetado pela plataforma.
# Alternativa explícita (apenas hostname interno curto dpg-...-a): DATABASE_SSL_MODE=render-internal
# Externo: DATABASE_SSL_MODE=verify-full (ou sslmode=verify-full na URL).
DATABASE_SSL_MODE=auto
NODE_ENV=production
PORT=3001
# Origem exata: sem caminho do repositório e sem barra final
FRONTEND_ORIGIN=https://rafaelcunha1111-cloud.github.io
# Caminho de CA confiável, se necessário (não desative verificação TLS)
# DATABASE_CA_CERT=/run/secrets/postgres-ca.pem
# Habilitar somente após domínio remetente validado e homologação:
# RESEND_API_KEY=
# EMAIL_FROM=
# RESEND_WEBHOOK_SECRET=
# WhatsApp Business Platform oficial, versão suportada validada na implantação:
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=
# WHATSAPP_TEMPLATE=
# WHATSAPP_LANGUAGE=pt_BR
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Nenhuma credencial de Comprasnet é solicitada: conector não homologado.

# Gmail OAuth (configure valores secretos somente no Render, nunca no GitHub)
# EMAIL_PROVIDER=gmail
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=https://rs-licitabot-api.onrender.com/oauth/gmail/callback
# GMAIL_SENDER_EMAIL=construcenter.licitacao@gmail.com
# Chave AES-256: 32 bytes aleatórios em base64, mesma chave na API e no worker.
# GMAIL_TOKEN_ENCRYPTION_KEY=
# WhatsApp permanece bloqueado mesmo que existam credenciais antigas:
WHATSAPP_ENABLED=false
